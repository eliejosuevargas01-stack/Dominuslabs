# Dominuslabs Backend Environment Configuration
# Copy this file to .env and fill in the values

# =============================================================================
# REQUIRED - Fail-closed: Startup will refuse if missing
# =============================================================================

# Authentication
JWT_SECRET=
ADMIN_PASSWORD=
VIEWER_PASSWORD=

# N8N Integration
N8N_WEBHOOK_SECRET=

# Hybrid Encryption
ENCRYPTION_MASTER_KEY=
DOMINUS_PRIVATE_KEY=
DOMINUS_PUBLIC_KEY=
IDPW_PUBLIC_KEY=
WHATSAPI_PUBLIC_KEY=

# External Services
IDENTITY_WORKER_URL=
WHATSAPP_API_URL=
WHATSAPP_PUBLIC_URL=

# =============================================================================
# PRODUCTION REQUIRED
# =============================================================================

# Database (required when ENVIRONMENT=production)
DATABASE_URL=postgresql://user:password@host:5432/database

# =============================================================================
# DEFAULTS (Optional - have safe defaults)
# =============================================================================

# Environment
ENVIRONMENT=development
ADMIN_USERNAME=admin
VIEWER_USERNAME=patrik182rodrigues@gmail.com

# Uploads
UPLOAD_DIR=./uploads

# N8N Webhooks (with defaults - set explicit URLs for production)
CRM_GET_LEADS_WEBHOOK_URL=
CRM_CREATE_LEAD_WEBHOOK_URL=
CRM_UPDATE_LEAD_WEBHOOK_URL=
CRM_DELETE_LEAD_WEBHOOK_URL=
CRM_GET_MESSAGES_WEBHOOK_URL=
CRM_CREATE_MESSAGE_WEBHOOK_URL=
CRM_SEND_WHATSAPP_WEBHOOK_URL=
CRM_UPDATE_STATUS_WEBHOOK_URL=
CRM_CREATE_ACTIVITY_WEBHOOK_URL=
ACCEPT_ORDER_WEBHOOK_URL=

# Timestamp tolerance for N8N webhooks
N8N_TIMESTAMP_TOLERANCE_SECONDS=300

# =============================================================================
# DEPRECATED (Migrate to new names)
# =============================================================================

# WEBHOOK_SECRET is deprecated, use N8N_WEBHOOK_SECRET instead
# WEBHOOK_SECRET=

# =============================================================================
# SECURITY NOTES
# =============================================================================

# 1. Never commit .env files to version control
# 2. Rotate JWT_SECRET regularly
# 3. Use strong passwords (16+ chars, mix case, numbers, symbols)
# 4. ENCRYPTION_MASTER_KEY must be exactly 64 hex characters (32 bytes AES-256)
# 5. Keep private keys secure and never expose them
