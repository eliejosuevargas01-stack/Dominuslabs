# Dominuslabs Backend Environment Configuration
# Copy this file to .env and fill in the values

# =============================================================================
# REQUIRED - Fail-closed: Startup will拒绝 if missing
# =============================================================================

# Authentication
JWT_SECRET=your-super-secret-jwt-key-minimum-32-chars
ADMIN_PASSWORD=admin-secure-password-change-me
VIEWER_PASSWORD=viewer-secure-password-change-me

# N8N Integration
N8N_WEBHOOK_SECRET=n8n-webhook-secret-here

# Hybrid Encryption
ENCRYPTION_MASTER_KEY=64-character-hex-string-0123456789abcdef0123456789abcdef
DOMINUS_PRIVATE_KEY=your-private-key-hex-or-pem
DOMINUS_PUBLIC_KEY=your-public-key-hex-or-pem
IDPW_PUBLIC_KEY=identity-worker-public-key
WHATSAPI_PUBLIC_KEY=whatsapp-api-public-key

# External Services
IDENTITY_WORKER_URL=https://your-identity-worker.example.com
WHATSAPP_API_URL=http://localhost:3000
WHATSAPP_PUBLIC_URL=https://your-domain.example.com

# =============================================================================
# PRODUCTION REQUIRED
# =============================================================================

# Database (required when ENVIRONMENT=production)
DATABASE_URL=postgresql://user:password@host:5432/database

# =============================================================================
# DEFAULTS (Optional - have safe defaults)
# =============================================================================

# Environment
ENVIRONMENT=development
ADMIN_USERNAME=admin
VIEWER_USERNAME=patrik182rodrigues@gmail.com

# Uploads
UPLOAD_DIR=./uploads

# N8N Webhooks (with defaults - set explicit URLs for production)
CRM_GET_LEADS_WEBHOOK_URL=
CRM_CREATE_LEAD_WEBHOOK_URL=
CRM_UPDATE_LEAD_WEBHOOK_URL=
CRM_DELETE_LEAD_WEBHOOK_URL=
CRM_GET_MESSAGES_WEBHOOK_URL=
CRM_CREATE_MESSAGE_WEBHOOK_URL=
CRM_SEND_WHATSAPP_WEBHOOK_URL=
CRM_UPDATE_STATUS_WEBHOOK_URL=
CRM_CREATE_ACTIVITY_WEBHOOK_URL=
ACCEPT_ORDER_WEBHOOK_URL=

# Timestamp tolerance for N8N webhooks
N8N_TIMESTAMP_TOLERANCE_SECONDS=300

# =============================================================================
# DEPRECATED (Migrate to new names)
# =============================================================================

# WEBHOOK_SECRET is deprecated, use N8N_WEBHOOK_SECRET instead
# WEBHOOK_SECRET=

# =============================================================================
# SECURITY NOTES
# =============================================================================

# 1. Never commit .env files to version control
# 2. Rotate JWT_SECRET regularly
# 3. Use strong passwords (16+ chars, mix case, numbers, symbols)
# 4. ENCRYPTION_MASTER_KEY must be exactly 64 hex characters (32 bytes AES-256)
# 5. Keep private keys secure and never expose them
