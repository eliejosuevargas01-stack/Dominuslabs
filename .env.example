# ==========================================
# Dominuslabs Environment Configuration
# ==========================================

# Port Configuration
PORT_FRONTEND=80
PORT_BACKEND=8000

# Frontend API URL
# Leave empty for same-domain proxying via Nginx or single-container,
# or set to explicit URL (e.g. for Cloudflare Pages / separate domain)
VITE_API_URL=

# Core Security & JWT Secrets (Change these in production!)
JWT_SECRET=replace-with-a-secure-random-secret-key-at-least-32-chars
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-admin-password-in-production
ADMIN_TENANT_ID=admin

# Integration Secrets
N8N_WEBHOOK_SECRET=replace-with-n8n-webhook-secret-at-least-32-chars
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database (Optional - defaults to SQLite in uploads directory if empty)
# Example PostgreSQL: postgresql://user:password@db:5432/dominuslabs
DATABASE_URL=

# Product media uploads (10 MiB by default)
PRODUCT_MEDIA_MAX_BYTES=10485760

# Service Endpoints
IDENTITY_WORKER_URL=https://idc-dominuslabs.eliejosuevargas01.workers.dev
WHATSAPP_API_URL=http://localhost:3000

# Zero-Trust Asymmetric Encryption Keys (PEM formatted strings or \\n-escaped single lines)
DOMINUS_PRIVATE_KEY=
DOMINUS_PUBLIC_KEY=
IDPW_PUBLIC_KEY=
WHATS_API_PUBLIC_KEY=
N8N_PUBLIC_KEY=

# N8N Integration Webhooks (Zero-Trust: must be explicitly configured via env)
CRM_GET_LEADS_WEBHOOK_URL=
CRM_CREATE_LEAD_WEBHOOK_URL=
CRM_UPDATE_LEAD_WEBHOOK_URL=
CRM_DELETE_LEAD_WEBHOOK_URL=
CRM_GET_MESSAGES_WEBHOOK_URL=
CRM_CREATE_MESSAGE_WEBHOOK_URL=
CRM_SEND_WHATSAPP_WEBHOOK_URL=
CRM_UPDATE_STATUS_WEBHOOK_URL=
CRM_CREATE_ACTIVITY_WEBHOOK_URL=
ACCEPT_ORDER_WEBHOOK_URL=
