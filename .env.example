# ==========================================
# Dominuslabs Environment Configuration
# ==========================================

# Port Configuration
PORT_FRONTEND=80
PORT_BACKEND=8000

# Frontend API URL
# Leave empty for same-domain proxying via Nginx or single-container,
# or set to explicit URL (e.g. for Cloudflare Pages / separate domain)
VITE_API_URL=

# Core Security & JWT Secrets (Change these in production!)
SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-32-chars
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-admin-password-in-production
ADMIN_TENANT_ID=admin

# Integration Secrets
N8N_WEBHOOK_SECRET=replace-with-n8n-webhook-secret-at-least-32-chars
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database (Optional - defaults to SQLite in uploads directory if empty)
# Example PostgreSQL: postgresql://user:password@db:5432/dominuslabs
DATABASE_URL=
